// ===========================================================================
//  Diagram 3 of 3 — The runtime fabric
//
//  Answers: how the three clusters reach each other at all, where bytes are
//  stored, and where telemetry ends up. This is the diagram that explains why
//  Ottawa going away is not the same kind of event as Robbinsdale going away.
//
//  Companions: 1-delivery.dot (how a commit becomes running infrastructure)
//              2-ingress.dot  (how a request reaches a service)
//
//  Rendered by tools/render-diagram.sh, gated by tools/check-diagram.sh.
//  Chart versions, bucket lists and per-node pool layouts live in
//  docs/reference/architecture.md.
//
//  Do not use inline <b> inside a text line — this Graphviz build mis-measures
//  the run and the glyphs overlap. Whole-line <b> is fine.
//
//  Apps this diagram names by their Flux Kustomization identity. The gate
//  fails if any of them stops being deployed, so a decommission cannot leave
//  a lie in the picture:
//  diagram-apps: bhaiya, hermes, forgejo, woodpecker, immich, teslamate,
//  diagram-apps: searxng, firecrawl, cliproxy, zot, opencost, tempvm,
//  diagram-apps: headlamp-install, velero, mimir, mimir-egress, victoria-logs,
//  diagram-apps: fluent-bit, gatus, kromgo, garage, spegel, tuppr, vpa, kro,
//  diagram-apps: external-secrets-install, gvisor, kata-containers,
//  diagram-apps: agent-sandbox, ocm, ocm-agent, media-apps, home-assistant,
//  diagram-apps: ai-inference, cnpg-system, dragonfly-operator-system,
//  diagram-apps: csi-driver-smb, local-path-storage, rook-ceph-operator
// ===========================================================================
digraph fabric {
  graph [
    rankdir=TB, compound=true, newrank=true, splines=spline,
    nodesep=0.38, ranksep=0.62, fontname="Helvetica", fontsize=11,
    labelloc="t", bgcolor="transparent",
    label=<<b>3 · Runtime fabric — tailnet, storage, observability</b><br/><font point-size="10">Tailscale is the only path between sites, and Ottawa holds the singletons the other two borrow</font>>
  ];
  node [fontname="Helvetica", fontsize=9, shape=box, style="filled,rounded",
        fillcolor="#ffffff", color="#8c959f", margin="0.22,0.10"];
  edge [fontname="Helvetica", fontsize=8, color="#57606a", arrowsize=0.7];

  // The node margin is deliberately roomier than Graphviz's default. When
  // rendered by the @hpcc-js wasm fallback there is no real Helvetica present,
  // so label widths get measured with substituted metrics while the browser
  // draws true Helvetica — long lines can then sit right against the border.
  // Prefer rendering with a real `dot` (which CI installs) for the canonical
  // SVG; the padding just keeps the fallback output presentable too.

  // ---------------------------------------------------------------- sites
  subgraph cluster_sites {
    label=<<b>The three clusters are not peers</b>>;
    style="rounded,filled"; fillcolor="#f6f8fa"; color="#8c959f"; fontsize=11;

    p_ot [label=<<b>talos-ottawa</b> — the hub<br align="left"/>Runs the singletons the other two borrow:<br align="left"/>Mimir, VictoriaLogs, Grafana, Tinyauth, the Zot<br align="left"/>registry and the Open Cluster Management hub.<br align="left"/>Rook-Ceph · SMB · Garage pools<br align="left"/>>,
          fillcolor="#dafbe1", color="#1a7f37", penwidth=1.8];

    p_rb [label=<<b>talos-robbinsdale</b><br align="left"/>home automation and media<br align="left"/>Rook-Ceph · SMB · Garage pools<br align="left"/>Borrows Ottawa's telemetry stack and Tinyauth.<br align="left"/>>,
          fillcolor="#dbeafe", color="#0550ae", penwidth=1.6];

    p_sp [label=<<b>talos-stpetersburg</b><br align="left"/>AI inference on two DGX Spark GB10 machines<br align="left"/>No Ceph at all — local-path for every tier,<br align="left"/>plus its own Garage pools.<br align="left"/>>,
          fillcolor="#ffe3ea", color="#a40e26", penwidth=1.6];
  }

  // ---------------------------------------------------------------- tailnet
  subgraph cluster_tailnet {
    label=<<b>Tailnet keiretsu.ts.net — the only path between sites</b>>;
    style="rounded,filled"; fillcolor="#f5f0ff"; color="#8250df"; fontsize=11;

    t_policy [label=<<b>tailscale/policy.hujson</b><br align="left"/>One central zero-trust policy: groups, tags,<br align="left"/>per-location ipsets, autoApprovers, recorded SSH,<br align="left"/>and grants that permit location-to-location<br align="left"/>traffic only through that location's own subnet<br align="left"/>router. Its tests run in CI beside it.<br align="left"/>>];

    t_op [label=<<b>tailscale-operator</b> — one per cluster<br align="left"/>Creates every device below from ProxyClass<br align="left"/>templates. Its OAuth credentials are<br align="left"/>SOPS-encrypted like everything else.<br align="left"/>>,
          penwidth=1.4];

    t_router [label=<<b>Subnet router and app connector</b><br align="left"/>advertise the LAN, pod, service and LoadBalancer<br align="left"/>CIDRs, plus a per-site 4via6 /96 range<br align="left"/>>];

    t_api [label=<<b>kube-apiserver ProxyGroup</b><br align="left"/>serves &lt;location&gt;-k8s-operator.keiretsu.ts.net<br align="left"/>TAILNET IDENTITY IS THE CREDENTIAL, which is why<br align="left"/>the committed kubeconfig carries no client cert,<br align="left"/>no key and only a placeholder token.<br align="left"/>>];

    t_egress [label=<<b>Egress ProxyGroup common-egress</b><br align="left"/>Backs every tailnet-fqdn Service, and therefore<br align="left"/>every cross-cluster dependency on this page.<br align="left"/>>,
              penwidth=1.4];

    t_dns [label=<<b>DNSConfig ts-dns</b><br align="left"/>A LoadBalancer nameserver that CoreDNS forwards<br align="left"/>ts.net to, so that pods — not just laptops — can<br align="left"/>resolve tailnet names.<br align="left"/>>];

    t_contract [label=<<b>The pod-side egress contract</b><br align="left"/>THE RULE THAT KEEPS BREAKING PEOPLE.<br align="left"/>For every tailnet name a pod consumes, declare in<br align="left"/>that namespace an ExternalName Service annotated<br align="left"/>with the tailnet FQDN and proxy-group:<br align="left"/>common-egress. The operator rewrites it to a proxy<br align="left"/>address and ts-dns republishes the original name.<br align="left"/>ts-dns PUBLISHES ONLY NAMES AN EGRESS SERVICE<br align="left"/>DECLARES — not every MagicDNS device.<br align="left"/>Verify TailscaleEgressSvcReady=True AND resolve<br align="left"/>the name from a throwaway pod. A laptop dig proves<br align="left"/>nothing: laptops use MagicDNS, pods do not.<br align="left"/>Never publish tailnet CGNAT addresses in public DNS.<br align="left"/>>,
                 fillcolor="#fff8c5", color="#9a6700", penwidth=1.4];
  }

  p_ot -> t_op [style=dotted, color="#1a7f37", label="LOCATION=ottawa"];
  p_rb -> t_op [style=dotted, color="#0550ae"];
  p_sp -> t_op [style=dotted, color="#a40e26"];

  t_op -> t_router;
  t_op -> t_api;
  t_op -> t_egress;
  t_op -> t_dns;

  t_policy -> t_op       [label="authorises every\ldevice the operator makes", style=dashed, constraint=false];
  t_egress -> t_contract [style=dashed];
  t_dns    -> t_contract [label="publishes only what\legress declares", style=dashed, constraint=false];

  // ---------------------------------------------------------------- storage
  subgraph cluster_storage {
    label=<<b>Storage — one federated S3 estate, plus per-site block and file</b>>;
    style="rounded,filled"; fillcolor="#fffbe6"; color="#9a6700"; fontsize=11;

    s_garage [label=<<b>Garage — one logical S3 estate, three zones</b><br align="left"/>Every cluster runs a GarageCluster, and each one<br align="left"/>lists all three zones and reaches the others over<br align="left"/>the tailnet. Replication factor 3, consistency<br align="left"/>mode degraded.<br align="left"/>>,
              fillcolor="#fff8c5", penwidth=1.6];

    s_gw [label=<<b>Apps never address the storage tier</b><br align="left"/>They use ${COMMON_S3_ENDPOINT}, the cluster-local<br align="left"/>gateway, for two reasons: the gateway carries the<br align="left"/>full key table so an S3 signature resolves<br align="left"/>locally, and it survives local storage loss by<br align="left"/>proxying reads to a surviving zone.<br align="left"/>>,
           fillcolor="#fff8c5", color="#9a6700"];

    s_pools [label=<<b>Garage local pools</b><br align="left"/>hostPath-backed and declared per node. The storage<br align="left"/>tier is Manual at all three sites, deliberately, so<br align="left"/>an array can be moved between backing stores; the<br align="left"/>gateway tier stays operator-managed.<br align="left"/>>];

    s_buckets [label=<<b>Buckets</b><br align="left"/>velero · mimir · zot · tailscale-logs, plus one<br align="left"/>&lt;db&gt;-postgres bucket per database so that<br align="left"/>federated sites never share a Barman catalog.<br align="left"/>Per-app credentials are minted by GarageKey CRs.<br align="left"/>>];

    s_rpc [label=<<b>Why Garage needs so many egress Services</b><br align="left"/>Its RPC is identity-authenticated per node, so it<br align="left"/>needs one ingress identity and one egress Service<br align="left"/>PER REMOTE NODE. A single shared L4 VIP cannot<br align="left"/>route a node identifier, so the usual one-Service<br align="left"/>shortcut does not work here.<br align="left"/>>,
           fillcolor="#fff8c5", color="#9a6700"];

    s_ceph [label=<<b>Rook-Ceph</b> — Ottawa and Robbinsdale only<br align="left"/>Block and filesystem, one CephCluster each, both<br align="left"/>on v20 — which IS Tentacle. Nothing is held back a<br align="left"/>major version; what is bounded is an mgr logging<br align="left"/>bug that floods the recent-log ring, capped by<br align="left"/>log_max_recent 100 until the fix lands (rook#17786).<br align="left"/>There is no CephObjectStore anywhere: all object<br align="left"/>storage is Garage.<br align="left"/>>];

    s_bulk [label=<<b>Bulk and node-local</b><br align="left"/>csi-driver-smb — media libraries, never databases<br align="left"/>local-path — every St. Petersburg tier, the model<br align="left"/>weights, and the backing store under the Garage<br align="left"/>hostPath pools<br align="left"/>>];

    s_db [label=<<b>Databases, caches and backup</b><br align="left"/>CloudNativePG — 10 Postgres clusters, streaming<br align="left"/>WAL and base backups to Garage<br align="left"/>Dragonfly — every cache; there is no real Redis in<br align="left"/>this repository, whatever the filenames say<br align="left"/>Velero — kopia file backup, not CSI snapshots<br align="left"/>>];
  }

  p_ot -> s_ceph [style=dotted, color="#1a7f37", constraint=false];
  p_rb -> s_ceph [style=dotted, color="#0550ae", constraint=false];
  p_sp -> s_bulk [label="no Ceph here", style=dotted, color="#a40e26", constraint=false];

  // Only the first of these constrains: fanning all four out from s_garage
  // would put them on one rank and make the panel four nodes wide.
  s_garage -> s_gw      [label="every app enters here", style=bold];
  s_garage -> s_pools   [label="Manual storage tier", constraint=false];
  s_garage -> s_buckets [constraint=false];
  s_garage -> s_rpc     [style=dashed, constraint=false];
  s_rpc    -> t_egress  [label="one egress Service\lper remote node", style=dashed, color="#9a6700", constraint=false];
  s_db     -> s_garage  [label="WAL, base backups\land Velero archives", style=bold, constraint=false];

  // ---------------------------------------------------------------- obs
  subgraph cluster_obs {
    label=<<b>Observability — collected in all three clusters, stored and queried in Ottawa</b>>;
    style="rounded,filled"; fillcolor="#f0fff4"; color="#1a7f37"; fontsize=11;

    o_local [label=<<b>In every cluster</b><br align="left"/>kube-prometheus-stack · Fluent Bit · Gatus<br align="left"/>Kromgo · blackbox and host exporters.<br align="left"/>Prometheus stamps externalLabels cluster=&lt;name&gt;,<br align="left"/>which is what keeps the three sites' series apart<br align="left"/>once they all land in one Mimir.<br align="left"/>Fluent Bit also receives Talos KERNEL logs over<br align="left"/>TCP, because every machine ships them there.<br align="left"/>>];

    o_store [label=<<b>Ottawa only</b><br align="left"/>Mimir — long-term metrics, blocks on Garage S3<br align="left"/>VictoriaLogs — logs, 7 day retention<br align="left"/>Grafana — the single pane of glass<br align="left"/>The other two clusters deploy only egress Services<br align="left"/>where these would be.<br align="left"/>>,
             fillcolor="#dafbe1", penwidth=1.4];

    o_trick [label=<<b>Why the other two need no extra configuration</b><br align="left"/>The remote-write and log-sink hostnames are the<br align="left"/>SAME STRING in all three clusters. In Ottawa that<br align="left"/>name is the real Service. Elsewhere the location<br align="left"/>tree ships only an ExternalName Service of exactly<br align="left"/>that name pointing at the tailnet FQDN.<br align="left"/>So Fluent Bit and Prometheus are configured<br align="left"/>identically everywhere. Worth copying.<br align="left"/>>,
             fillcolor="#fff8c5", color="#9a6700"];

    o_probe [label=<<b>Probes check both paths on purpose</b><br align="left"/>Gatus checks the in-cluster endpoint AND its<br align="left"/>tailnet equivalent, so a broken overlay is<br align="left"/>distinguishable from a broken service.<br align="left"/>>];
  }

  o_local -> o_store  [label="remote-write and logs", style=bold];
  o_local -> o_trick  [style=dashed, constraint=false];
  o_trick -> t_egress [label="resolved by the\legress ProxyGroup", style=dashed, constraint=false];
  o_store -> s_garage [label="metric blocks", style=bold, constraint=false];
  o_local -> o_probe  [style=dashed, constraint=false];

  // ---------------------------------------------------------------- work
  subgraph cluster_work {
    label=<<b>What the fabric exists to carry — full list in reference/inventory.md</b>>;
    style="rounded,filled"; fillcolor="#fff5f7"; color="#a40e26"; fontsize=11;

    k_media [label=<<b>Media</b> — Ottawa and Robbinsdale<br align="left"/>Plex, the full *arr stack, usenet and two torrent<br align="left"/>clients. Libraries on SMB, databases on Ceph.<br align="left"/>Ottawa adds the book, manga and audiobook titles.<br align="left"/>>];

    k_ai [label=<<b>Inference</b> — St. Petersburg<br align="left"/>ONE vLLM model spans BOTH DGX Sparks through a<br align="left"/>LeaderWorkerSet, and the two halves talk over a<br align="left"/>private RDMA rail rather than the LAN.<br align="left"/>hermes and cliproxy in Ottawa consume it over the<br align="left"/>tailnet, like any other cross-site dependency.<br align="left"/>>,
           fillcolor="#ffe3ea"];

    k_ott [label=<<b>Ottawa-only services</b><br align="left"/>bhaiya · hermes · forgejo · woodpecker<br align="left"/>immich · teslamate · searxng · firecrawl · cliproxy<br align="left"/>zot registry · headlamp · opencost · tempvm<br align="left"/>>];

    k_plat [label=<<b>Platform primitives</b><br align="left"/>priority classes · kro · spegel · tuppr · VPA<br align="left"/>external-secrets · Open Cluster Management<br align="left"/>the gVisor, Kata and agent-sandbox runtimes<br align="left"/>>];
  }

  k_media -> s_bulk   [label="libraries", style=dotted, constraint=false];
  k_media -> s_db     [style=dotted, constraint=false];
  k_ai    -> s_bulk   [label="model weights", style=dotted, constraint=false];
  k_ai    -> t_egress [label="consumed across\lthe tailnet", style=dashed, constraint=false];
  k_ott   -> s_gw     [label="S3 via ${COMMON_S3_ENDPOINT}", style=dotted, constraint=false];
  k_plat  -> t_egress [label="kro generates the\legress pattern", style=dotted, constraint=false];

  // ---------------------------------------------------------------- layout
  // Band the panels vertically. Without these, storage, observability and
  // workloads have no constraining in-edge, so all three float to rank 0 and
  // the drawing comes out five panels wide instead of one column deep.
  t_contract -> s_garage [style=invis];
  s_db       -> o_local  [style=invis];
  o_probe    -> k_media  [style=invis];

  p_ot -> p_rb -> p_sp   [style=invis];
  t_policy -> t_router   [style=invis];
  t_api -> t_egress      [style=invis];
  t_dns -> t_contract    [style=invis];
  // Storage is two columns hanging off s_garage. The second column needs its
  // own anchor, or its nodes float to rank 0 and the panel's box stretches
  // the whole height of the drawing.
  s_gw -> s_pools -> s_buckets -> s_rpc [style=invis];
  s_garage -> s_ceph [style=invis];
  s_ceph -> s_bulk -> s_db [style=invis];
  o_store -> o_trick -> o_probe [style=invis];
  k_media -> k_ai -> k_ott -> k_plat [style=invis];
}
